<script>
(function(){
  var b=document.getElementById('toggleAll');
  if(!b) return;
  b.addEventListener('click',function(){
    var w=document.querySelectorAll('details.week');
    var open=b.getAttribute('data-open')!=='1';
    w.forEach(function(d){d.open=open});
    b.setAttribute('data-open',open?'1':'0');
    b.textContent=open?'Collapse all weeks':'Expand all weeks';
  });
})();
</script>

