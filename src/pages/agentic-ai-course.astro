---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const LINKEDIN = "https://www.linkedin.com/in/chaubeyrahul/";
const YOUTUBE = "https://www.youtube.com/@BuildAutomateArchitect";
const TELEGRAM = "https://t.me/BuildAutomateArchitect";

// TODO(rahul): set the batch start date, e.g. "Saturday 6 December 2026". Empty = "Dates announced soon".
const START_DATE = "";
// TODO(rahul): set the fee, e.g. "₹XX,XXX". Empty = the fee line is hidden.
const FEE = "";
// Web3Forms access key (public by design; registrations are emailed to the account owner).
const WEB3FORMS_KEY = "631c38f9-f2fd-4abf-8725-6f29237bc5a4";

const changing = [
  {
    t: "AI writes the first draft",
    d: "Terraform, pipelines, Dockerfiles and scripts now take minutes, not days. Writing that code alone is worth less every month.",
  },
  {
    t: "Job descriptions have moved",
    d: "Cloud and DevOps roles now list GenAI, RAG, agents and LLMOps next to AWS, Azure and Kubernetes.",
  },
  {
    t: "Companies want AI in production",
    d: "Not demos. Secure, monitored, cost-controlled AI systems that run every day — and that is infrastructure work.",
  },
];

const mapping = [
  ["IAM and least privilege", "Agent tool permissions and guardrails"],
  ["Kubernetes and containers", "Scalable agent deployment"],
  ["CI/CD pipelines", "LLMOps and evaluation pipelines"],
  ["Monitoring and observability", "Agent tracing and cost control"],
];

const week = [
  { d: "Saturday", t: "6 hrs live", s: "concepts + build", live: true },
  { d: "Sunday", t: "6 hrs live", s: "build + deploy", live: true },
  { d: "Mon – Tue", t: "Your lab time", s: "finish the build", live: false },
  { d: "Mid-week", t: "Live doubt call", s: "get unblocked", live: true },
  { d: "Thu – Fri", t: "Push to GitHub", s: "ready for Saturday", live: false },
];

const weekends = [
  { n: "W1", sat: ["LLMs in Python", "APIs, prompts, structured output"], sun: ["RAG", "Chunking, embeddings, vector search"] },
  { n: "W2", full: ["Project 1 · Python to Production", "AI triage service in FastAPI → Docker → deployed on EKS"] },
  { n: "W3", sat: ["AI agents from scratch", "Tools, agent loop, memory, approval"], sun: ["MCP", "Build and secure an MCP server"] },
  { n: "W4", full: ["Project 2 · EKS SRE Agent", "Diagnose a broken cluster through the EKS MCP server, fix it with your approval"] },
  { n: "W5", sat: ["Multi-agent systems", "LangGraph and CrewAI"], sun: ["Project 3 · Well-Architected Agent", "Terraform → six-pillar risk report"], sunProject: true },
  { n: "W6", sat: ["Capstone build", "Supervisor + SRE, review and cost agents"], satProject: true, sun: ["Demo day + career", "Demos, LinkedIn, CV, mock interviews"] },
];

const projects = [
  { k: "Project 1 · Weekend 2", t: "Python to Production", s: "FastAPI · Docker · EKS", p: "Take an AI service from “works on my laptop” to running on EKS." },
  { k: "Project 2 · Weekend 4", t: "EKS SRE Agent", s: "Agents · MCP · Slack", p: "A pod is crashing at 2 a.m. The agent finds why and proposes the fix." },
  { k: "Project 3 · Weekend 5", t: "Well-Architected Review Agent", s: "RAG · Terraform", p: "Review infrastructure code for security, cost and reliability risks in minutes." },
  { k: "Capstone · Weekend 6", t: "AI Cloud Operations Platform", s: "Multi-agent · CI/CD · tracing", p: "Several agents run cloud operations together, with a human approving every change.", cap: true },
];

const outcomes = [
  "Design end-to-end Agentic AI solutions",
  "Build AI agents in Python and modern frameworks",
  "Design RAG and multi-agent architectures",
  "Connect agents to enterprise systems with MCP",
  "Deploy and run AI on AWS and Azure",
  "Explain your design trade-offs like an architect",
];

const audience = [
  "Cloud engineers (AWS or Azure)",
  "DevOps, platform engineers and SREs",
  "Solution and enterprise architects",
  "Technical consultants",
  "Software engineers moving into AI",
  "Tech leads and engineering managers",
];

const faqs = [
  {
    q: "Do I need a data-science or machine-learning background?",
    a: "No. This program is about designing, building and running AI systems, not training models. If you have deployed anything to AWS or Azure, you have the foundation.",
  },
  {
    q: "How much time does it take each week?",
    a: "12 hours live every weekend (6 on Saturday, 6 on Sunday), a short mid-week doubt-clearing call, and a few hours of lab work during the week. The program runs for 6 weekends.",
  },
  {
    q: "What should I do before the first weekend?",
    a: "Watch the free foundations playlist on YouTube covering AI, LLMs and Transformers. It means every live hour goes into building.",
  },
  {
    q: "Is there a job guarantee?",
    a: "No. The program builds real capability and a portfolio you can show — 4 working repos, a capstone you can explain, and interview preparation. The career move is yours to make, and we support it.",
  },
];
---

<BaseLayout
  title="Agentic AI for Cloud & DevOps Professionals — Rahul Chaubey Consulting"
  description="A 6-weekend live program for Cloud and DevOps engineers: build AI agents, RAG and MCP integrations, and deploy them on AWS and Azure. 3 real-world projects and a capstone."
>
  <Header />

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-inner">
        <p class="kicker">Live program · 6 weekends · For Cloud &amp; DevOps engineers</p>
        <h1 class="display">Agentic AI for Cloud &amp; DevOps Professionals</h1>
        <p class="lede">
          From Cloud Engineering to Enterprise AI Solution Architecture. Learn to design, build
          and deploy AI agents on AWS and Azure — without throwing away a single skill you
          already have.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#register">Register your interest</a>
          <a class="text-link" href="#timeline">See the 6-weekend plan</a>
        </div>
        <dl class="facts">
          <div><dt>Format</dt><dd>Live, Sat &amp; Sun, 6 hrs each</dd></div>
          <div><dt>Duration</dt><dd>6 weekends</dd></div>
          <div><dt>You build</dt><dd>3 projects + 1 capstone</dd></div>
          <div><dt>Next batch</dt><dd>{START_DATE || "Dates announced soon"}</dd></div>
        </dl>
      </div>
    </section>

    <!-- Problem -->
    <section class="section" aria-labelledby="prob-h">
      <div class="wrap">
        <p class="eyebrow">The problem</p>
        <h2 id="prob-h" class="heading">Your job is already changing</h2>
        <ul class="ruled three">
          {changing.map((c) => (
            <li>
              <h3 class="subheading">{c.t}</h3>
              <p class="body">{c.d}</p>
            </li>
          ))}
        </ul>
        <p class="statement">
          The engineers in demand next can take AI from <span>demo to production</span>. And
          production is infrastructure, security and operations work — the work you already do.
        </p>
      </div>
    </section>

    <!-- Closer than you think -->
    <section class="section" aria-labelledby="close-h">
      <div class="wrap">
        <p class="eyebrow">The good news</p>
        <h2 id="close-h" class="heading">You're closer than you think</h2>
        <div class="map" role="table" aria-label="Skills you have and what they become">
          <div class="map-row map-head" role="row">
            <span role="columnheader">What you already know</span>
            <span aria-hidden="true"></span>
            <span role="columnheader">What it becomes in Agentic AI</span>
          </div>
          {mapping.map(([a, b]) => (
            <div class="map-row" role="row">
              <span role="cell">{a}</span>
              <span class="arrow" aria-hidden="true">→</span>
              <span role="cell" class="to">{b}</span>
            </div>
          ))}
        </div>
        <p class="body note">You don't start over. You add the AI layer on top of what you know.</p>
      </div>
    </section>

    <!-- Week rhythm -->
    <section class="section" aria-labelledby="week-h">
      <div class="wrap">
        <p class="eyebrow">How it runs</p>
        <h2 id="week-h" class="heading">Every week: two live days and one doubt-clearing call</h2>
        <ol class="week">
          {week.map((w) => (
            <li class:list={["box", { live: w.live }]}>
              <strong>{w.d}</strong>
              <span>{w.t}</span>
              <span class="small">{w.s}</span>
            </li>
          ))}
        </ol>
        <p class="small key"><span class="swatch" aria-hidden="true"></span> Live with Rahul. The same rhythm repeats for all 6 weekends.</p>
      </div>
    </section>

    <!-- Timeline -->
    <section id="timeline" class="section" aria-labelledby="tl-h">
      <div class="wrap">
        <p class="eyebrow">The plan</p>
        <h2 id="tl-h" class="heading">Six weekends from your first API call to a cloud capstone</h2>
        <div class="tl">
          <div class="tl-pre box">Before weekend 1 · free YouTube foundations on AI, LLMs and Transformers</div>
          <div class="tl-head" aria-hidden="true"><span></span><span>Saturday · 6 hrs</span><span>Sunday · 6 hrs</span></div>
          {weekends.map((w) => (
            <div class="tl-row">
              <span class="tl-n">{w.n}</span>
              {w.full ? (
                <div class="box live tl-full"><strong>{w.full[0]}</strong><span class="small">{w.full[1]}</span></div>
              ) : (
                <>
                  <div class:list={["box", { live: w.satProject }]}><strong><span class="tl-day">Sat · </span>{w.sat[0]}</strong><span class="small">{w.sat[1]}</span></div>
                  <div class:list={["box", { live: w.sunProject }]}><strong><span class="tl-day">Sun · </span>{w.sun[0]}</strong><span class="small">{w.sun[1]}</span></div>
                </>
              )}
            </div>
          ))}
        </div>
        <p class="small key"><span class="swatch" aria-hidden="true"></span> Project build time. A mid-week doubt-clearing call runs every week.</p>
      </div>
    </section>

    <!-- Projects -->
    <section class="section" aria-labelledby="proj-h">
      <div class="wrap">
        <p class="eyebrow">What you build</p>
        <h2 id="proj-h" class="heading">3 real-world projects + 1 capstone, in your own GitHub</h2>
        <ol class="projects">
          {projects.map((p) => (
            <li class:list={["box", { live: p.cap }]}>
              <span class="small">{p.k}</span>
              <h3 class="subheading">{p.t}</h3>
              <p class="body">{p.p}</p>
              <span class="stack">{p.s}</span>
            </li>
          ))}
        </ol>
        <p class="small">Projects 2 and 3 become agents inside the capstone.</p>
      </div>
    </section>

    <!-- Capstone flow -->
    <section class="section" aria-labelledby="cap-h">
      <div class="wrap cap-grid">
        <div class="cap-text">
          <p class="eyebrow">The capstone</p>
          <h2 id="cap-h" class="heading">AI Cloud Operations Platform</h2>
          <p class="body">
            Agents investigate, and nothing changes in the cloud without human approval. This is
            the system you show in an interview: multiple agents, real cloud tools, an approval
            step, and production practices around it.
          </p>
        </div>
        <ol class="flow" aria-label="Capstone flow">
          <li class="box">An alert fires, or an engineer asks in Slack</li>
          <li class="box"><strong>ChatOps API</strong></li>
          <li class="box live"><strong>Supervisor agent</strong> decides who handles it</li>
          <li class="flow-agents">
            <span class="box"><strong>SRE agent</strong><span class="small">pods, logs, events</span></span>
            <span class="box"><strong>Review agent</strong><span class="small">Well-Architected checks</span></span>
            <span class="box"><strong>Cost agent</strong><span class="small">spend and waste</span></span>
          </li>
          <li class="box">MCP tools (EKS, CloudWatch, Cost Explorer) + RAG over runbooks</li>
          <li class="box gate"><strong>Human approval before any change</strong></li>
          <li class="box">Fix applied + report posted back to Slack</li>
          <li class="flow-base small">Runs on AWS or Azure · EKS / AKS · IaC · CI/CD · tracing and evals</li>
        </ol>
      </div>
    </section>

    <!-- Outcomes + audience -->
    <section class="section" aria-label="Outcomes and audience">
      <div class="wrap two-col">
        <div>
          <h2 class="heading">After this program, you can</h2>
          <ul class="checks">
            {outcomes.map((o) => <li>{o}</li>)}
          </ul>
          <p class="small">Plus code reviews, LinkedIn and CV support, and mock interviews on the final weekend.</p>
        </div>
        <div>
          <h2 class="heading">Who it's for</h2>
          <ul class="checks">
            {audience.map((a) => <li>{a}</li>)}
          </ul>
          <p class="small">You don't need a data-science background.</p>
        </div>
      </div>
    </section>

    <!-- Instructor -->
    <section class="section" aria-labelledby="ins-h">
      <div class="wrap">
        <p class="eyebrow">Your instructor</p>
        <h2 id="ins-h" class="heading">Rahul Chaubey</h2>
        <p class="lede">Director, Cloud and AI Engineering at Winfo Solutions.</p>
        <ul class="ruled three ins">
          <li><p class="body">Two decades across AWS, Microsoft and Oracle — from Unix sysadmin to DevOps lead, Technical Account Manager and architect.</p></li>
          <li><p class="body">Built a cloud and AI practice from zero to around forty engineers, and has shipped agentic AI to production on AWS Bedrock.</p></li>
          <li><p class="body">M.Tech BITS Pilani, EGMP IIM Bangalore, Agentic AI certificate from IIT Madras. Teaches live batches for Scaler and Intellipaat.</p></li>
        </ul>
        <p class="links">
          <a class="text-link" href={YOUTUBE} rel="noopener" target="_blank">YouTube</a>
          <a class="text-link" href={LINKEDIN} rel="me noopener" target="_blank">LinkedIn</a>
          <a class="text-link" href={TELEGRAM} rel="noopener" target="_blank">Telegram</a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-h">
      <div class="wrap">
        <h2 id="faq-h" class="heading">Questions</h2>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class="body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Register -->
    <section id="register" class="section register" aria-labelledby="reg-h">
      <div class="wrap reg-grid">
        <div class="reg-text">
          <h2 id="reg-h" class="display reg-h">Lead the change.</h2>
          <p class="lede">
            Register your interest and I'll get in touch with the batch dates, fee and next steps.
          </p>
          <dl class="facts compact">
            <div><dt>Next batch</dt><dd>{START_DATE || "Dates announced soon"}</dd></div>
            {FEE && <div><dt>Fee</dt><dd>{FEE}</dd></div>}
            <div><dt>Schedule</dt><dd>Sat &amp; Sun, 6 hrs live + mid-week call</dd></div>
          </dl>
        </div>

        <form class="reg-form" action="https://api.web3forms.com/submit" method="POST" data-reg-form>
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="New registration — Agentic AI for Cloud & DevOps Professionals" />
          <input type="hidden" name="from_name" value="rahulchaubeyconsulting.com" />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label>Full name<input name="name" type="text" required autocomplete="name" /></label>
          <label>Email<input name="email" type="email" required autocomplete="email" /></label>
          <label>Phone / WhatsApp<input name="phone" type="tel" required autocomplete="tel" /></label>
          <label>Current role<input name="role" type="text" required placeholder="e.g. DevOps Engineer" /></label>
          <label>Years of experience
            <select name="experience" required>
              <option value="">Select</option>
              <option>0–3 years</option>
              <option>3–7 years</option>
              <option>7–12 years</option>
              <option>12+ years</option>
            </select>
          </label>
          <label>LinkedIn profile <span class="opt">(optional)</span><input name="linkedin" type="url" placeholder="https://linkedin.com/in/…" /></label>
          <label class="full">What do you want from this program? <span class="opt">(optional)</span><textarea name="goal" rows="3"></textarea></label>

          <button class="btn full" type="submit">Register my interest</button>
          <p class="small full form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-reg-form]");
  if (form) {
    const status = form.querySelector<HTMLElement>(".form-status");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (btn) btn.disabled = true;
      if (status) status.textContent = "Sending…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          form.reset();
          if (status) status.textContent = "Thank you — you're registered. I'll be in touch with the batch details soon.";
        } else {
          throw new Error(json.message || "Submission failed");
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again, or message me on LinkedIn.";
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>

<style>
  .eyebrow, .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 14px;
  }

  /* Hero */
  .hero { padding-block: clamp(56px, 8vw, 104px) clamp(56px, 8vw, 96px); }
  .hero-inner { display: grid; gap: 26px; }
  .hero-inner .display { max-width: 15em; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 16px 0 0;
    border-top: 1px solid var(--graphite);
  }
  .facts div { padding: 16px 20px 0 0; }
  .facts dt { font-size: 0.875rem; color: var(--slate); }
  .facts dd { margin: 4px 0 0; font-weight: 600; }
  .facts.compact { grid-template-columns: 1fr; border-top: 0; margin-top: 8px; }
  .facts.compact div { padding: 12px 0; border-top: 1px solid var(--rule); }

  /* Ruled columns — same idiom as the homepage services */
  .ruled { display: grid; gap: 32px clamp(24px, 4vw, 56px); margin-top: 40px; }
  .ruled.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ruled li { display: grid; gap: 12px; align-content: start; padding-top: 22px; border-top: 1px solid var(--graphite); }

  .statement {
    margin-top: clamp(48px, 6vw, 72px);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.012em;
    max-width: 30em;
    text-wrap: balance;
  }
  .statement span { color: var(--teal); }

  /* Skill mapping */
  .map { margin-top: 36px; max-width: 900px; }
  .map-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);
    align-items: center;
    padding-block: 16px;
    border-top: 1px solid var(--rule);
    font-weight: 500;
  }
  .map-head { font-size: 0.875rem; color: var(--slate); font-weight: 500; border-top: 0; padding-bottom: 8px; }
  .arrow { color: var(--teal); text-align: center; }
  .to { color: var(--teal); }
  .note { margin-top: 20px; }

  /* Boxes — outlined, teal tint for live/project */
  .box {
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
    padding: 16px 18px;
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .box.live {
    border-color: var(--teal);
    background: color-mix(in srgb, var(--teal) 8%, var(--paper));
  }
  .box.gate {
    border-color: #b7791f;
    background: color-mix(in srgb, #b7791f 10%, var(--paper));
  }
  .key { display: flex; align-items: center; gap: 8px; margin-top: 16px; }
  .swatch {
    width: 14px; height: 14px; border-radius: 3px;
    border: 1px solid var(--teal);
    background: color-mix(in srgb, var(--teal) 8%, var(--paper));
  }

  /* Week */
  .week { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: 36px; }
  .week .box { text-align: center; }

  /* Timeline */
  .tl { display: grid; gap: 10px; margin-top: 36px; }
  .tl-pre { text-align: center; background: transparent; border-style: dashed; margin-left: 56px; }
  .tl-head, .tl-row { display: grid; grid-template-columns: 46px 1fr 1fr; gap: 10px; align-items: stretch; }
  .tl-head span { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); text-align: center; padding-top: 6px; }
  .tl-n { font-weight: 600; align-self: center; }
  .tl-full { grid-column: 2 / 4; text-align: center; }
  .tl-row .box { text-align: center; }
  .tl-day { display: none; }

  /* Projects */
  .projects { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 36px 0 16px; }
  .projects .box { gap: 10px; padding: 22px; }
  .stack { font-size: 0.875rem; font-weight: 500; color: var(--teal); margin-top: auto; }

  /* Capstone flow */
  .cap-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 40px clamp(32px, 6vw, 96px); align-items: start; }
  .cap-text { display: grid; gap: 16px; }
  .flow { display: grid; gap: 22px; position: relative; }
  .flow > li { position: relative; text-align: center; }
  .flow > li:not(:last-child):not(:nth-last-child(2))::after {
    content: "↓";
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    color: var(--slate);
    font-size: 0.9rem;
    line-height: 22px;
  }
  .flow-agents { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .flow-base { border-top: 1px solid var(--rule); padding-top: 12px; }

  /* Lists */
  .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px clamp(32px, 6vw, 96px); }
  .two-col > div { display: grid; gap: 20px; align-content: start; }
  .checks { display: grid; gap: 0; }
  .checks li { padding: 12px 0 12px 28px; border-top: 1px solid var(--rule); position: relative; font-weight: 500; }
  .checks li::before { content: "✓"; position: absolute; left: 2px; color: var(--teal); }

  .ins { margin-top: 32px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 28px; }

  /* FAQ */
  .faq { margin-top: 32px; max-width: 820px; }
  .faq details { border-top: 1px solid var(--rule); padding: 18px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--rule); }
  .faq summary { cursor: pointer; font-weight: 600; list-style-position: outside; }
  .faq details p { margin-top: 10px; }

  /* Register */
  .register { padding-block: clamp(72px, 10vw, 128px); }
  .reg-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 40px clamp(32px, 6vw, 96px); align-items: start; }
  .reg-text { display: grid; gap: 20px; }
  .reg-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
