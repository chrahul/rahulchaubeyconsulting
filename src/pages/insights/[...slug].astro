---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const entries = await getCollection("insights");

  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — Rahul Chaubey Consulting`}
  description={entry.data.description}
>
  <Header />

  <main id="main">
    <article>
      <header class="article-header">
        <div class="wrap article-wrap">
          <p class="small">
            {entry.data.pubDate.toLocaleDateString("en-IN", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </p>
          <h1 class="display">{entry.data.title}</h1>
          <p class="lede">{entry.data.description}</p>
        </div>
      </header>

      <div class="wrap article-wrap prose">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    padding-block: clamp(56px, 8vw, 96px) clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--rule);
  }

  .article-wrap {
    max-width: 760px;
  }

  .article-header .small {
    margin-bottom: 16px;
  }

  .article-header .display {
    margin-bottom: 20px;
  }

  .prose {
    max-width: 760px;
    padding-block: clamp(40px, 6vw, 72px) clamp(72px, 9vw, 120px);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .prose :global(p) {
    max-width: 70ch;
    margin-block: 0 1.45em;
  }

  .prose :global(h2) {
    margin-block: 2.2em 0.7em;
    color: var(--graphite);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    margin-block: 1.8em 0.6em;
    color: var(--graphite);
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 500;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0 1.5em;
    padding-left: 1.5em;
  }

  .prose :global(li) {
    margin-block: 0.45em;
  }

  .prose :global(blockquote) {
    margin-block: 2em;
    padding-left: 1.25em;
    border-left: 2px solid var(--rule);
    color: var(--slate);
  }

  .prose :global(a) {
    color: var(--teal);
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-block: 2.5rem;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1.25rem;
    margin-block: 2em;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  @media (max-width: 760px) {
    .prose {
      font-size: 1rem;
    }

    .prose :global(img) {
      margin-block: 2rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>(".prose img").forEach((image) => {
    const src = image.currentSrc || image.src;
    const link = document.createElement("a");
    link.href = src;
    link.target = "_blank";
    link.rel = "noopener";
    link.setAttribute("aria-label", "Open diagram at full size");

    image.parentNode?.insertBefore(link, image);
    link.appendChild(image);
  });
</script>
