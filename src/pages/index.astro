---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Topology from "../components/Topology.astro";

const LINKEDIN = "https://www.linkedin.com/in/chaubeyrahul/";
const YOUTUBE = "https://www.youtube.com/@BuildAutomateArchitect";
// TODO(rahul): replace with the exact course URL on the Graphy LMS.
const COURSE_URL = "https://unametechnology.com";

const path = [
  "System administration on Solaris and Unix",
  "AWS",
  "DevOps, then DevOps team lead",
  "Technical account management",
  "Cloud and solution architecture",
  "Cloud and AI engineering leadership",
];
---

<BaseLayout>
  <Header />

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <h1 class="display">Clear thinking for hard technology decisions.</h1>
          <p class="lede">
            I'm Rahul Chaubey. I advise technology professionals on their next career move,
            and organisations on Cloud and AI, drawing on twenty years across AWS, Microsoft,
            Oracle and IBM ecosystems.
          </p>
          <div class="hero-actions">
            <a class="btn" href="#contact">Talk about your career</a>
            <a class="text-link" href="#contact">Discuss a Cloud or AI project</a>
          </div>
        </div>
        <div class="hero-art">
          <Topology />
        </div>
      </div>
    </section>

    <!-- Who -->
    <section class="section" aria-labelledby="who-h">
      <div class="wrap">
        <h2 id="who-h" class="heading">Who I work with</h2>
        <div class="two-col">
          <div>
            <h3 class="subheading">Technology professionals</h3>
            <p class="body">
              You're strong at the work and unsure of the next step. Usually five to fifteen
              years in, across DevOps, SRE, cloud or platform engineering, and looking at
              architecture or leadership.
            </p>
          </div>
          <div>
            <h3 class="subheading">Organisations</h3>
            <p class="body">
              You're planning a cloud or AI transformation and want an experienced,
              independent view before committing budget and people to it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="section" aria-labelledby="svc-h">
      <div class="wrap">
        <h2 id="svc-h" class="heading">How I can help</h2>
        <ul class="services">
          <li>
            <h3 class="subheading">Career advisory</h3>
            <p class="body">
              One-to-one guidance on where you stand, which role to target, and how to
              position yourself for it: your CV, LinkedIn, portfolio and interviews.
            </p>
          </li>
          <li>
            <h3 class="subheading">Cloud and AI advisory</h3>
            <p class="body">
              Architecture and platform reviews, cloud modernisation, and practical AI
              adoption, including governance, security and cost.
            </p>
          </li>
          <li>
            <h3 class="subheading">Technology leadership</h3>
            <p class="body">
              A senior sounding board for technology leaders on strategy, operating models,
              and the architecture decisions that are expensive to reverse.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="section" aria-labelledby="exp-h">
      <div class="wrap exp-grid">
        <div>
          <h2 id="exp-h" class="heading">Twenty years of doing the work</h2>
          <p class="body exp-intro">
            I didn't start as an architect. I started as a system administrator. Each role
            since has changed the question I was being asked to answer, from how to keep a
            system running, to what problem the customer is actually trying to solve.
          </p>
          <p class="body">
            Along the way I built a cloud and AI practice from zero to around forty
            engineers, architects and leads. I hold an M.Tech from BITS Pilani, an EGMP from
            IIM Bangalore, and a professional certificate in Agentic AI from IIT Madras.
          </p>
        </div>
        <ol class="path" aria-label="Career path">
          {path.map((step, i) => (
            <li>
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <span class="step-t">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Courses + Insights -->
    <section class="section" aria-label="Courses and insights">
      <div class="wrap two-col learn">
        <div id="courses">
          <h2 class="heading">Courses</h2>
          <p class="body">
            My structured course, Modern System Design for the AI Era, is hosted on my
            learning platform.
          </p>
          <p class="learn-action">
            <a class="btn" href={COURSE_URL} rel="noopener" target="_blank">View the course</a>
          </p>
        </div>
        <div id="insights">
          <h2 class="heading">Insights</h2>
          <p class="body">
            I write about cloud, AI and technology careers on LinkedIn, and publish a free
            System Design series on YouTube.
          </p>
          <p class="learn-action links">
            <a class="text-link" href={LINKEDIN} rel="me noopener" target="_blank">Read on LinkedIn</a>
            <a class="text-link" href={YOUTUBE} rel="noopener" target="_blank">Watch on YouTube</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section contact" aria-labelledby="ct-h">
      <div class="wrap">
        <h2 id="ct-h" class="display contact-h">Start with a conversation.</h2>
        <p class="lede">
          Tell me where you are and what you're trying to decide. If I'm not the right
          person to help, I'll say so.
        </p>
        <p class="contact-action">
          <a class="btn" href={LINKEDIN} rel="me noopener" target="_blank">Message me on LinkedIn</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero { padding-block: clamp(56px, 8vw, 112px) clamp(64px, 9vw, 120px); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero-text { display: grid; gap: 28px; }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 8px;
  }
  .hero-art { max-width: 560px; justify-self: end; width: 100%; }

  /* Two columns */
  .two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px clamp(32px, 6vw, 96px);
    margin-top: 40px;
  }
  .two-col > div { display: grid; gap: 12px; align-content: start; }
  .learn { margin-top: 0; }

  /* Services — typographic, top-ruled, not cards */
  .services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px clamp(24px, 4vw, 56px);
    margin-top: 40px;
  }
  .services li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px solid var(--graphite);
  }

  /* Experience */
  .exp-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .exp-grid > div { display: grid; gap: 20px; }
  .exp-intro { margin-top: 4px; }

  .path { display: grid; gap: 0; border-left: 1px solid var(--rule); }
  .path li {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    padding: 14px 0 14px 0;
    position: relative;
  }
  .path li::before {
    content: "";
    position: absolute;
    left: -4px;
    top: 24px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--stone);
    border: 1.5px solid var(--slate);
  }
  .path li:last-child::before { background: var(--teal); border-color: var(--teal); }
  .step-n {
    font-size: 0.875rem;
    color: var(--slate);
    font-variant-numeric: tabular-nums;
    padding-left: 22px;
  }
  .step-t { font-weight: 500; }
  .path li:last-child .step-t { color: var(--teal); }

  /* Courses + insights */
  .learn-action { margin-top: 12px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; }

  /* Contact */
  .contact { padding-block: clamp(72px, 10vw, 140px); }
  .contact .wrap { display: grid; gap: 24px; }
  .contact-h { max-width: 14em; }
  .contact-action { margin-top: 8px; }

  /* Responsive */
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { justify-self: start; max-width: 460px; }
    .services { grid-template-columns: 1fr; }
    .exp-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
